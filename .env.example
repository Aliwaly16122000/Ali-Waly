# Copy to server/.env or pass as environment variables.
PORT=4000
# Where the SQLite database and uploaded files are stored.
DATA_DIR=./data
# Initial admin account created on first start of an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Timetable reminders run in this timezone.
APP_TIMEZONE=Africa/Cairo
# Attendance percentage below which students get an absence warning.
ABSENCE_THRESHOLD=75
MAX_UPLOAD_MB=20
# Contact for Web Push (required by push services).
PUSH_SUBJECT=mailto:it@your-faculty.edu.eg
# Optional: fixed JWT secret (otherwise generated and stored in the database).
# JWT_SECRET=
